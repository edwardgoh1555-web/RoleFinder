# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail:   smtp.gmail.com  / port 587  (create an App Password at myaccount.google.com)
# Outlook: smtp-mail.outlook.com / port 587
# SendGrid: smtp.sendgrid.net / port 587  (use apikey as SMTP_USER, API key as SMTP_PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-sender@gmail.com
EMAIL_TO=edward-goh@outlook.com

# ── Schedule (24-hour, server local time) ────────────────────────────────────
CRAWL_HOUR=8
CRAWL_MINUTE=0

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
